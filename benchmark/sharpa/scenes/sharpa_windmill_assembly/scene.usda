        def Xform "rotor" (prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "PhysxRigidBodyAPI"])
        {
            double3 xformOp:translate = (-0.23, 0.4, 0.7981)
            quatd xformOp:orient = (1, 0, 0, 0)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]
            float physics:mass = 0.024
            bool physics:rigidBodyEnabled = true
