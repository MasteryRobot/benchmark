            float physics:mass = 0.16384
            bool physics:rigidBodyEnabled = true
            bool physxRigidBody:enableCCD = true
            int physxRigidBody:solverPositionIterationCount = 32
            int physxRigidBody:solverVelocityIterationCount = 16
            float physxRigidBody:angularDamping = 0.5
            def Sphere "part_0" (prepend apiSchemas = ["PhysicsCollisionAPI", "PhysxCollisionAPI", "MaterialBindingAPI"])
