#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Z"
    timeCodesPerSecond = 240
    subLayers = [@../../../tasks/workcell.usdc@]
)
def Xform "World"
{
    def Scope "SharpaLooks"
    {
        def Material "camera_body_Physics" (prepend apiSchemas = ["PhysicsMaterialAPI"])
        {
            float physics:staticFriction = 0.8
            float physics:dynamicFriction = 0.65
            float physics:restitution = 0.01
        }
        def Material "camera_body_0"
        {
            token outputs:surface.connect = </World/SharpaLooks/camera_body_0/Surface.outputs:surface>
            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.11, 0.13, 0.16)
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }
        def Material "camera_body_1"
        {
            token outputs:surface.connect = </World/SharpaLooks/camera_body_1/Surface.outputs:surface>
            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.19, 0.21, 0.25)
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }
        def Material "camera_body_2"
        {
            token outputs:surface.connect = </World/SharpaLooks/camera_body_2/Surface.outputs:surface>
            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.75, 0.2, 0.16)
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }
        def Material "subject_Physics" (prepend apiSchemas = ["PhysicsMaterialAPI"])
        {
            float physics:staticFriction = 0.8
            float physics:dynamicFriction = 0.65
            float physics:restitution = 0.01
        }
        def Material "subject_0"
        {
            token outputs:surface.connect = </World/SharpaLooks/subject_0/Surface.outputs:surface>
            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.9, 0.55, 0.2)
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }
    }
    def Xform "Task"
    {
        custom string task:id = "sharpa_camera_photography"
        custom string task:provenance = "UNVERIFIED_LOCAL_PROTOTYPE"
        def Xform "camera_body" (prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "PhysxRigidBodyAPI"])
        {
            double3 xformOp:translate = (0.23, 0.4, 0.8351)
            quatd xformOp:orient = (1, 0, 0, 0)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]
            float physics:mass = 0.32
            bool physics:rigidBodyEnabled = true
            bool physxRigidBody:enableCCD = true
            int physxRigidBody:solverPositionIterationCount = 32
            int physxRigidBody:solverVelocityIterationCount = 16
            float physxRigidBody:angularDamping = 0.5
            def Cube "part_0" (prepend apiSchemas = ["PhysicsCollisionAPI", "PhysxCollisionAPI", "MaterialBindingAPI"])
            {
                double3 xformOp:translate = (0, 0, 0)
                double xformOp:rotateZ = 0
                double size = 1
                float3 xformOp:scale = (0.13, 0.045, 0.08)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateZ", "xformOp:scale"]
                color3f[] primvars:displayColor = [(0.11, 0.13, 0.16)]
                bool physics:collisionEnabled = true
                float physxCollision:contactOffset = 0.0003
                float physxCollision:restOffset = 0
                rel material:binding:physics = </World/SharpaLooks/camera_body_Physics>
                rel material:binding = </World/SharpaLooks/camera_body_0>
            }
            def Cylinder "part_1" (prepend apiSchemas = ["PhysicsCollisionAPI", "PhysxCollisionAPI", "MaterialBindingAPI"])
            {
                double3 xformOp:translate = (0, 0.043, 0)
                double xformOp:rotateZ = 0
                double radius = 0.025
                double height = 0.045
                uniform token axis = "Y"
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateZ"]
                color3f[] primvars:displayColor = [(0.19, 0.21, 0.25)]
                bool physics:collisionEnabled = true
                float physxCollision:contactOffset = 0.0003
                float physxCollision:restOffset = 0
                rel material:binding:physics = </World/SharpaLooks/camera_body_Physics>
                rel material:binding = </World/SharpaLooks/camera_body_1>
            }
            def Cube "part_2" (prepend apiSchemas = ["PhysicsCollisionAPI", "PhysxCollisionAPI", "MaterialBindingAPI"])
            {
                double3 xformOp:translate = (0.045, 0, 0.043)
                double xformOp:rotateZ = 0
                double size = 1
                float3 xformOp:scale = (0.014, 0.012, 0.006)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateZ", "xformOp:scale"]
                color3f[] primvars:displayColor = [(0.75, 0.2, 0.16)]
                bool physics:collisionEnabled = true
                float physxCollision:contactOffset = 0.0003
                float physxCollision:restOffset = 0
                rel material:binding:physics = </World/SharpaLooks/camera_body_Physics>
                rel material:binding = </World/SharpaLooks/camera_body_2>
            }
            def Camera "CaptureCamera"
            {
                double3 xformOp:translate = (0, 0.067, 0)
                quatd xformOp:orient = (0.707106781187, 0.707106781187, 0, 0)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]
                float focalLength = 12
                float horizontalAperture = 36
                float verticalAperture = 20.25
                float2 clippingRange = (0.01, 20)
            }
        }
        def Xform "subject"
        {
            double3 xformOp:translate = (0, 0.74, 0.795)
            quatd xformOp:orient = (1, 0, 0, 0)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]
            def Cube "part_0" (prepend apiSchemas = ["PhysicsCollisionAPI", "PhysxCollisionAPI", "MaterialBindingAPI"])
            {
                double3 xformOp:translate = (0, 0, 0.09)
                double xformOp:rotateZ = 0
                double size = 1
                float3 xformOp:scale = (0.12, 0.018, 0.18)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateZ", "xformOp:scale"]
                color3f[] primvars:displayColor = [(0.9, 0.55, 0.2)]
                bool physics:collisionEnabled = true
                float physxCollision:contactOffset = 0.0003
                float physxCollision:restOffset = 0
                rel material:binding:physics = </World/SharpaLooks/subject_Physics>
                rel material:binding = </World/SharpaLooks/subject_0>
            }
        }
        def Xform "Goals"
        {
            def BasisCurves "camera_body"
            {
                double3 xformOp:translate = (0, 0.4, 0.96)
                quatd xformOp:orient = (1, 0, 0, 0)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]
                uniform token type = "linear"
                uniform token wrap = "nonperiodic"
                int[] curveVertexCounts = [2, 2, 2]
                point3f[] points = [(-0.025, 0, 0), (0.025, 0, 0), (0, -0.025, 0), (0, 0.025, 0), (0, 0, 0), (0, 0, 0.035)]
                float[] widths = [0.001]
                color3f[] primvars:displayColor = [(0.1, 0.9, 0.7)]
            }
        }
    }
    over "PhysicsScene"
    {
        bool physxScene:enableCCD = true
    }
}
