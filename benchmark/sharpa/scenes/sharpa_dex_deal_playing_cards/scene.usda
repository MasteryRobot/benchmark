    def Scope "SharpaLooks"
    {
        def Material "card_1_Physics" (prepend apiSchemas = ["PhysicsMaterialAPI"])
        {
            float physics:staticFriction = 0.8
            float physics:dynamicFriction = 0.65
            float physics:restitution = 0.01
        }
        def Material "card_1_0"
        {
            token outputs:surface.connect = </World/SharpaLooks/card_1_0/Surface.outputs:surface>
            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.86, 0.88, 0.92)
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }
