#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Z"
    timeCodesPerSecond = 240
    subLayers = [@../../../tasks/workcell.usdc@]
)
def Xform "World"
{
    def Scope "SharpaLooks"
    {
        def Material "object_1_Physics" (prepend apiSchemas = ["PhysicsMaterialAPI"])
        {
            float physics:staticFriction = 0.8
            float physics:dynamicFriction = 0.65
            float physics:restitution = 0.01
        }
        def Material "object_1_0"
        {
            token outputs:surface.connect = </World/SharpaLooks/object_1_0/Surface.outputs:surface>
            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.22, 0.48, 0.65)
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }
        def Material "object_2_Physics" (prepend apiSchemas = ["PhysicsMaterialAPI"])
        {
            float physics:staticFriction = 0.8
            float physics:dynamicFriction = 0.65
            float physics:restitution = 0.01
        }
        def Material "object_2_0"
        {
            token outputs:surface.connect = </World/SharpaLooks/object_2_0/Surface.outputs:surface>
            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.22, 0.48, 0.65)
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }
        def Material "object_3_Physics" (prepend apiSchemas = ["PhysicsMaterialAPI"])
        {
            float physics:staticFriction = 0.8
            float physics:dynamicFriction = 0.65
            float physics:restitution = 0.01
        }
        def Material "object_3_0"
        {
            token outputs:surface.connect = </World/SharpaLooks/object_3_0/Surface.outputs:surface>
            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.22, 0.48, 0.65)
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }
    }
    def Xform "Task"
    {
        custom string task:id = "sharpa_dex_reposition_and_stack_blocks"
        custom string task:provenance = "UNVERIFIED_LOCAL_PROTOTYPE"
        def Xform "object_1" (prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "PhysxRigidBodyAPI"])
        {
            double3 xformOp:translate = (-0.38, 0.35, 0.8127)
            quatd xformOp:orient = (1, 0, 0, 0)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]
            float physics:mass = 0.07
            bool physics:rigidBodyEnabled = true
            bool physxRigidBody:enableCCD = true
            int physxRigidBody:solverPositionIterationCount = 32
            int physxRigidBody:solverVelocityIterationCount = 16
            float physxRigidBody:angularDamping = 0.5
            def Cube "part_0" (prepend apiSchemas = ["PhysicsCollisionAPI", "PhysxCollisionAPI", "MaterialBindingAPI"])
            {
                double3 xformOp:translate = (0, 0, 0)
                double xformOp:rotateZ = 0
                double size = 1
                float3 xformOp:scale = (0.035, 0.035, 0.035)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateZ", "xformOp:scale"]
                color3f[] primvars:displayColor = [(0.22, 0.48, 0.65)]
                bool physics:collisionEnabled = true
                float physxCollision:contactOffset = 0.0003
                float physxCollision:restOffset = 0
                rel material:binding:physics = </World/SharpaLooks/object_1_Physics>
                rel material:binding = </World/SharpaLooks/object_1_0>
            }
        }
        def Xform "object_2" (prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "PhysxRigidBodyAPI"])
        {
            double3 xformOp:translate = (-0.16, 0.35, 0.8127)
            quatd xformOp:orient = (1, 0, 0, 0)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]
            float physics:mass = 0.07
            bool physics:rigidBodyEnabled = true
            bool physxRigidBody:enableCCD = true
            int physxRigidBody:solverPositionIterationCount = 32
            int physxRigidBody:solverVelocityIterationCount = 16
            float physxRigidBody:angularDamping = 0.5
            def Cube "part_0" (prepend apiSchemas = ["PhysicsCollisionAPI", "PhysxCollisionAPI", "MaterialBindingAPI"])
            {
                double3 xformOp:translate = (0, 0, 0)
                double xformOp:rotateZ = 0
                double size = 1
                float3 xformOp:scale = (0.035, 0.035, 0.035)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateZ", "xformOp:scale"]
                color3f[] primvars:displayColor = [(0.22, 0.48, 0.65)]
                bool physics:collisionEnabled = true
                float physxCollision:contactOffset = 0.0003
                float physxCollision:restOffset = 0
                rel material:binding:physics = </World/SharpaLooks/object_2_Physics>
                rel material:binding = </World/SharpaLooks/object_2_0>
            }
        }
        def Xform "object_3" (prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "PhysxRigidBodyAPI"])
        {
            double3 xformOp:translate = (0.06, 0.35, 0.8127)
            quatd xformOp:orient = (1, 0, 0, 0)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]
            float physics:mass = 0.07
            bool physics:rigidBodyEnabled = true
            bool physxRigidBody:enableCCD = true
            int physxRigidBody:solverPositionIterationCount = 32
            int physxRigidBody:solverVelocityIterationCount = 16
            float physxRigidBody:angularDamping = 0.5
            def Cube "part_0" (prepend apiSchemas = ["PhysicsCollisionAPI", "PhysxCollisionAPI", "MaterialBindingAPI"])
            {
                double3 xformOp:translate = (0, 0, 0)
                double xformOp:rotateZ = 0
                double size = 1
                float3 xformOp:scale = (0.035, 0.035, 0.035)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateZ", "xformOp:scale"]
                color3f[] primvars:displayColor = [(0.22, 0.48, 0.65)]
                bool physics:collisionEnabled = true
                float physxCollision:contactOffset = 0.0003
                float physxCollision:restOffset = 0
                rel material:binding:physics = </World/SharpaLooks/object_3_Physics>
                rel material:binding = </World/SharpaLooks/object_3_0>
            }
        }
        def Xform "Goals"
        {
            def BasisCurves "object_1"
            {
                double3 xformOp:translate = (0.18, 0.49, 0.8125)
                quatd xformOp:orient = (1, 0, 0, 0)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]
                uniform token type = "linear"
                uniform token wrap = "nonperiodic"
                int[] curveVertexCounts = [2, 2, 2]
                point3f[] points = [(-0.025, 0, 0), (0.025, 0, 0), (0, -0.025, 0), (0, 0.025, 0), (0, 0, 0), (0, 0, 0.035)]
                float[] widths = [0.001]
                color3f[] primvars:displayColor = [(0.1, 0.9, 0.7)]
            }
            def BasisCurves "object_2"
            {
                double3 xformOp:translate = (0.18, 0.49, 0.8475)
                quatd xformOp:orient = (1, 0, 0, 0)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]
                uniform token type = "linear"
                uniform token wrap = "nonperiodic"
                int[] curveVertexCounts = [2, 2, 2]
                point3f[] points = [(-0.025, 0, 0), (0.025, 0, 0), (0, -0.025, 0), (0, 0.025, 0), (0, 0, 0), (0, 0, 0.035)]
                float[] widths = [0.001]
                color3f[] primvars:displayColor = [(0.1, 0.9, 0.7)]
            }
            def BasisCurves "object_3"
            {
                double3 xformOp:translate = (0.18, 0.49, 0.8825)
                quatd xformOp:orient = (1, 0, 0, 0)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]
                uniform token type = "linear"
                uniform token wrap = "nonperiodic"
                int[] curveVertexCounts = [2, 2, 2]
                point3f[] points = [(-0.025, 0, 0), (0.025, 0, 0), (0, -0.025, 0), (0, 0.025, 0), (0, 0, 0), (0, 0, 0.035)]
                float[] widths = [0.001]
                color3f[] primvars:displayColor = [(0.1, 0.9, 0.7)]
            }
        }
    }
    over "PhysicsScene"
    {
        bool physxScene:enableCCD = true
    }
}
