                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateZ", "xformOp:scale"]
                color3f[] primvars:displayColor = [(0.67, 0.7, 0.73)]
                token visibility = "invisible"
                bool physics:collisionEnabled = true
                float physxCollision:contactOffset = 0.0003
                float physxCollision:restOffset = 0
                rel material:binding:physics = </World/SharpaLooks/object_1_Physics>
                rel material:binding = </World/SharpaLooks/object_1_1>
            }
            def Xform "RealisticVisual" (
                prepend references = @../../../assets/realistic/032_knife.usdc@</Asset>
            )
            {
                double3 xformOp:translate = (0, 0.005, 0.00247741931294)
                double3 xformOp:scale = (0.838190427161, 0.838190427161, 0.838190427161)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
                custom string asset:source = "https://ycb-benchmarks.s3.amazonaws.com/data/google/032_knife_google_16k.tgz"
                custom string asset:license = "CC-BY-4.0"
            }
        }
