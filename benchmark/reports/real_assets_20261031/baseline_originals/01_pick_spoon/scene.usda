    def "TaskLooks"
    {
        def Material "M0"
        {
            token outputs:surface.connect = </World/TaskLooks/M0/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.1, 0.135, 0.15)
                float inputs:metallic = 0
                float inputs:roughness = 0.3
                token outputs:surface
            }
        }

