#usda 1.0
(
    subLayers = [@../../sharpa/scenes/sharpa_dex_grind_medicine_with_mortar_and_pestle/scene.usda@]
)
over "World"
{
    over "PhysicsScene" (prepend apiSchemas = ["PhysxSceneAPI"])
